{
  "name": "core.openwop.workflows.it-support",
  "version": "1.2.1",
  "kind": "workflow-chain",
  "description": "Real-work workflow pack — the IT / Support cluster: Incident Triage & Major-Incident Comms. An AI classifier assesses each incident's severity; routine incidents go to a recommended knowledge-base article and a ticket, while major incidents go to human-approved stakeholder updates in Slack — and each incident finishes with a post-incident summary. All tenant values are run parameters (replay-deterministic). Resolves on hosts shipping the kb + http + ai + chat + integration packs. Published under core.openwop.workflows.* (openwop-team key).",
  "author": "openwop",
  "license": "Apache-2.0",
  "engines": { "openwop": ">=1.0.0" },
  "keywords": ["IT"],
  "chains": [
    {
      "chainId": "it-support.incident-triage",
      "version": "1.1.1",
      "label": "Incident Triage & Major-Incident Comms",
      "description": "Assesses each incident's severity, then routes routine incidents to a recommended knowledge-base article and a ticket, and major incidents to human-approved stakeholder updates in Slack — finishing with a post-incident summary.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alert"],
        "properties": {
          "alert": { "type": "string", "description": "The incoming alert/ticket text." },
          "ticketingBaseUrl": { "type": "string", "default": "", "description": "The tenant's ticketing instance REST base (e.g. https://acme.atlassian.net or https://acme.service-now.com). Empty ⇒ no ticket is created." },
          "ticketProject": { "type": "string", "default": "OPS", "description": "Project/queue key for the created ticket." }
        }
      },
      "capabilities": ["side-effectful"],
      "dag": {
        "nodes": [
          { "id": "classify", "typeId": "core.ai.structuredOutput", "name": "Classify severity", "position": { "x": 0, "y": 60 }, "config": { "systemPrompt": "Classify this IT incident's severity. 'major' = widespread outage, security incident, or SLA-breaching impact; 'routine' = single-user or low-impact. Alert: {{params.alert}}", "outputSchema": { "type": "object", "additionalProperties": false, "required": ["severity"], "properties": { "severity": { "type": "string", "enum": ["major", "routine"], "description": "The assigned severity." } } } }, "inputs": {} },
          { "id": "route", "typeId": "core.flow.router", "name": "Route by severity", "position": { "x": 280, "y": 60 }, "config": { "mode": "first-match", "defaultLabel": "routine", "routes": [ { "label": "major", "predicate": { "path": "severity", "op": "eq", "value": "major" } } ] }, "inputs": {} },
          { "id": "kbArticle", "typeId": "feature.kb.nodes.rag", "name": "Recommend KB article", "position": { "x": 560, "y": 0 }, "config": { "query": "{{params.alert}}" }, "inputs": {} },
          { "id": "ticket", "typeId": "core.openwop.connectors.ticket-create", "name": "Route on-call (ticketing)", "position": { "x": 840, "y": 0 }, "config": { "baseUrl": "{{params.ticketingBaseUrl}}", "project": "{{params.ticketProject}}", "summary": "On-call incident: {{params.alert}}" }, "inputs": {} },
          { "id": "majorApprove", "typeId": "core.chat.approvalGate", "name": "Approve stakeholder comms", "position": { "x": 560, "y": 160 }, "config": {}, "inputs": {} },
          { "id": "stakeholders", "typeId": "core.openwop.integration.slack-message", "name": "Cadence updates (Slack)", "position": { "x": 840, "y": 160 }, "config": {}, "inputs": {} },
          { "id": "summary", "typeId": "core.ai.chatCompletion", "name": "Post-incident summary", "position": { "x": 1120, "y": 80 }, "config": { "systemPrompt": "Write a post-incident summary: timeline, impact, resolution, and follow-ups." }, "inputs": {} },
          { "id": "notify", "typeId": "core.openwop.integration.notification-push", "name": "Distribute summary", "position": { "x": 1400, "y": 80 }, "config": {}, "inputs": {} }
        ],
        "edges": [
          { "from": "classify.data", "to": "route.value" },
          { "from": "route", "to": "kbArticle", "condition": { "type": "contains", "left": "branches", "right": "routine" } },
          { "from": "route", "to": "majorApprove", "condition": { "type": "contains", "left": "branches", "right": "major" } },
          { "from": "kbArticle", "to": "ticket" },
          { "from": "majorApprove", "to": "stakeholders" },
          { "from": "ticket", "to": "summary" },
          { "from": "stakeholders", "to": "summary" },
          { "from": "summary", "to": "notify" }
        ]
      },
      "outputs": { "postmortem": { "type": "string", "description": "Routed incident + status updates + post-mortem." } }
    }
  ]
}
