{
  "name": "openwop-registry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OpenWOP pack ecosystem \u2014 source packs (packs/) and the published registry catalog (registry/) served at packs.openwop.dev.",
  "license": "Apache-2.0",
  "scripts": {
    "build:index": "node registry/scripts/build-index.mjs",
    "check": "bash scripts/registry-check.sh",
    "check:vendored": "node scripts/check-vendored-sync.mjs",
    "build:index:v2": "node registry/scripts/build-index.mjs --tree v2",
    "test:v2": "node --test scripts/test-registry-v2-schemas.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
