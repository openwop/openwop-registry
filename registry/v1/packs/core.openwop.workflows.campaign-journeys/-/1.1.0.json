{
  "name": "core.openwop.workflows.campaign-journeys",
  "version": "1.1.0",
  "kind": "workflow-chain",
  "description": "Contact-level lifecycle journeys as RFC 0013 chains on the ONE engine (ADR 0222 / campaign gap plan C6) — NOT a journey engine. Trigger with an ADR 0208 host-event binding (e.g. host.crm.contact.created → Welcome Series), guard with the enrollment + eligibility verbs (one run per contact per journey; every send behind consent + suppression), wait with core.flow.wait, send with the existing email node, log with the CRM activity verb. Enrollment state is the run itself — monitor in Runs, reset re-enrollment via the campaign-journeys API.",
  "author": "openwop",
  "license": "Apache-2.0",
  "engines": {
    "openwop": ">=1.0.0"
  },
  "keywords": [
    "Marketing",
    "Campaign Studio",
    "Lifecycle"
  ],
  "chains": [
    {
      "chainId": "campaign-journeys.welcome-series",
      "version": "1.0.0",
      "label": "Welcome Series (2-step)",
      "description": "New contact → welcome email → wait a day → follow-up email. A sign-off gate fronts the first send (approval policies can auto-clear it for hands-off runs). Bind it to host.crm.contact.created (the contact rides the event payload), or run it manually with a contactId. The enrollment guard makes redelivered events harmless; every send passes consent + suppression first.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fromAddress"
        ],
        "properties": {
          "contactId": {
            "type": "string",
            "description": "The contact to enroll (omit when event-triggered — it rides the trigger payload)."
          },
          "fromAddress": {
            "type": "string",
            "description": "The verified sender address."
          },
          "welcomeSubject": {
            "type": "string",
            "default": "Welcome!",
            "description": "Subject of the first email."
          },
          "welcomeBody": {
            "type": "string",
            "default": "Thanks for joining us — here is what to expect.",
            "description": "Body of the first email."
          },
          "followUpSubject": {
            "type": "string",
            "default": "Getting the most out of your first week",
            "description": "Subject of the day-2 email."
          },
          "followUpBody": {
            "type": "string",
            "default": "A few favorite starting points, one day in.",
            "description": "Body of the day-2 email."
          }
        }
      },
      "capabilities": [
        "side-effectful"
      ],
      "dag": {
        "nodes": [
          {
            "id": "trigger",
            "typeId": "core.trigger.event",
            "name": "Contact event",
            "position": {
              "x": 0,
              "y": 0
            },
            "config": {},
            "inputs": {}
          },
          {
            "id": "enroll",
            "typeId": "feature.campaign-journeys.nodes.enroll",
            "name": "Enrollment guard",
            "position": {
              "x": 220,
              "y": 0
            },
            "config": {},
            "inputs": {
              "journeyId": "welcome-series",
              "contactId": "{{params.contactId}}"
            }
          },
          {
            "id": "gate1",
            "typeId": "feature.campaign-journeys.nodes.eligibility",
            "name": "Eligibility (consent + suppression)",
            "position": {
              "x": 440,
              "y": 0
            },
            "config": {},
            "inputs": {
              "contactId": "{{params.contactId}}"
            }
          },
          {
            "id": "signoff",
            "typeId": "core.chat.approvalGate",
            "name": "Approve the series",
            "position": {
              "x": 550,
              "y": 0
            },
            "config": {
              "title": "Start the welcome series for this contact?",
              "prompt": "Two emails will be sent (welcome now, follow-up in a day). Approval policies can auto-clear this gate for hands-off operation."
            },
            "inputs": {}
          },
          {
            "id": "welcome",
            "typeId": "core.openwop.integration.email-send",
            "name": "Welcome email",
            "position": {
              "x": 660,
              "y": 0
            },
            "config": {},
            "inputs": {
              "from": "{{params.fromAddress}}",
              "subject": "{{params.welcomeSubject}}",
              "body": "{{params.welcomeBody}}"
            }
          },
          {
            "id": "wait",
            "typeId": "core.flow.wait",
            "name": "Wait one day",
            "position": {
              "x": 880,
              "y": 0
            },
            "config": {
              "mode": "duration",
              "seconds": 86400
            },
            "inputs": {}
          },
          {
            "id": "gate2",
            "typeId": "feature.campaign-journeys.nodes.eligibility",
            "name": "Re-check eligibility",
            "position": {
              "x": 1100,
              "y": 0
            },
            "config": {},
            "inputs": {
              "contactId": "{{params.contactId}}"
            }
          },
          {
            "id": "followup",
            "typeId": "core.openwop.integration.email-send",
            "name": "Follow-up email",
            "position": {
              "x": 1320,
              "y": 0
            },
            "config": {},
            "inputs": {
              "from": "{{params.fromAddress}}",
              "subject": "{{params.followUpSubject}}",
              "body": "{{params.followUpBody}}"
            }
          }
        ],
        "edges": [
          {
            "from": "trigger",
            "to": "enroll"
          },
          {
            "from": "enroll",
            "to": "gate1"
          },
          {
            "from": "gate1",
            "to": "signoff"
          },
          {
            "from": "signoff",
            "to": "welcome.signoff"
          },
          {
            "from": "gate1",
            "to": "welcome.gate1"
          },
          {
            "from": "welcome",
            "to": "wait"
          },
          {
            "from": "wait",
            "to": "gate2"
          },
          {
            "from": "gate2",
            "to": "followup"
          }
        ]
      },
      "outputs": {
        "contactId": {
          "type": "string",
          "description": "The enrolled contact."
        }
      }
    },
    {
      "chainId": "campaign-journeys.re-engage-contact",
      "version": "1.0.0",
      "label": "Re-engage a Contact",
      "description": "One quiet contact → human sign-off → re-engagement email + a CRM follow-up task. Run it manually, from the Strategist in chat, or bind it to an event carrying a contactId. Segment-wide sweeps are the recorded follow-on (they need per-member fan-out).",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contactId",
          "fromAddress",
          "orgId"
        ],
        "properties": {
          "contactId": {
            "type": "string",
            "description": "The contact to re-engage."
          },
          "fromAddress": {
            "type": "string",
            "description": "The verified sender address."
          },
          "orgId": {
            "type": "string",
            "description": "The CRM org that owns the follow-up task (feature.crm.nodes.create-task is org-scoped)."
          },
          "subject": {
            "type": "string",
            "default": "We saved your spot",
            "description": "Re-engagement subject."
          },
          "body": {
            "type": "string",
            "default": "It has been a while — here is what changed since your last visit.",
            "description": "Re-engagement body."
          }
        }
      },
      "capabilities": [
        "side-effectful"
      ],
      "dag": {
        "nodes": [
          {
            "id": "enroll",
            "typeId": "feature.campaign-journeys.nodes.enroll",
            "name": "Enrollment guard",
            "position": {
              "x": 0,
              "y": 0
            },
            "config": {},
            "inputs": {
              "journeyId": "re-engage",
              "contactId": "{{params.contactId}}"
            }
          },
          {
            "id": "gate",
            "typeId": "feature.campaign-journeys.nodes.eligibility",
            "name": "Eligibility (consent + suppression)",
            "position": {
              "x": 220,
              "y": 0
            },
            "config": {},
            "inputs": {
              "contactId": "{{params.contactId}}"
            }
          },
          {
            "id": "signoff",
            "typeId": "core.chat.approvalGate",
            "name": "Approve the outreach",
            "position": {
              "x": 440,
              "y": 0
            },
            "config": {
              "title": "Re-engage this contact?",
              "prompt": "A re-engagement email will be sent to this quiet contact."
            },
            "inputs": {}
          },
          {
            "id": "send",
            "typeId": "core.openwop.integration.email-send",
            "name": "Re-engagement email",
            "position": {
              "x": 660,
              "y": 0
            },
            "config": {},
            "inputs": {
              "from": "{{params.fromAddress}}",
              "subject": "{{params.subject}}",
              "body": "{{params.body}}"
            }
          },
          {
            "id": "task",
            "typeId": "feature.crm.nodes.create-task",
            "name": "Follow-up task",
            "position": {
              "x": 880,
              "y": 0
            },
            "config": {
              "title": "Follow up on re-engagement",
              "orgId": "{{params.orgId}}"
            },
            "inputs": {}
          }
        ],
        "edges": [
          {
            "from": "enroll",
            "to": "gate"
          },
          {
            "from": "gate",
            "to": "signoff"
          },
          {
            "from": "signoff",
            "to": "send.signoff"
          },
          {
            "from": "send",
            "to": "task"
          },
          {
            "from": "gate",
            "to": "send.gate"
          }
        ]
      },
      "outputs": {
        "contactId": {
          "type": "string",
          "description": "The re-engaged contact."
        }
      }
    },
    {
      "chainId": "campaign-journeys.segment-winback",
      "version": "1.0.0",
      "label": "Segment Winback (per-member fan-out)",
      "description": "One quiet SEGMENT → resolve its members (capped) → a data-driven supervisor fans ONE re-engagement child workflow out over every member, each child receiving its OWN contactId (RFC 0126 per-item input on core.dispatch, ADR 0255). This is the segment-wide sweep the single-contact `re-engage-contact` chain deferred (its own description: 'Segment-wide sweeps are the recorded follow-on — they need per-member fan-out'). WIRING: install `campaign-journeys.re-engage-contact` FIRST in DEFERRED mode (`POST /workflows/from-chain {chainId, deferred:true}`) so each fanned child binds its own contactId + shared params per run rather than a frozen one, then pass that returned workflowId as `childWorkflowId`. Every per-member child still runs the full enroll-guard + consent/suppression + sign-off + send + follow-up-task path; idempotent by the child enroll-CAS, so a re-swept segment never double-sends. Bounded by the segment-members cap (5000) and the host fan-out cap. Run it with a `segmentId` (the segment rides the run inputs).",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "childWorkflowId",
          "fromAddress",
          "orgId"
        ],
        "properties": {
          "childWorkflowId": {
            "type": "string",
            "description": "The installed re-engage-contact workflow id (e.g. `wf.campaign-journeys-re-engage-contact.<hash>`) each member fans out to. Install `campaign-journeys.re-engage-contact` in DEFERRED mode first (so the per-member contactId + shared params bind per child run, not a frozen value) and paste its returned workflowId here."
          },
          "fromAddress": {
            "type": "string",
            "description": "The verified sender address, forwarded to every per-member child."
          },
          "orgId": {
            "type": "string",
            "description": "The CRM org that owns each member's follow-up task, forwarded to every child."
          },
          "subject": {
            "type": "string",
            "default": "We saved your spot",
            "description": "Re-engagement subject, shared across the whole segment."
          },
          "body": {
            "type": "string",
            "default": "It has been a while — here is what changed since your last visit.",
            "description": "Re-engagement body, shared across the whole segment."
          }
        }
      },
      "capabilities": [
        "side-effectful"
      ],
      "dag": {
        "nodes": [
          {
            "id": "segment",
            "typeId": "feature.campaign-journeys.nodes.segment-members",
            "name": "Resolve segment members",
            "position": {
              "x": 0,
              "y": 0
            },
            "config": {},
            "inputs": {}
          },
          {
            "id": "plan",
            "typeId": "feature.campaign-journeys.nodes.segment-winback-plan",
            "name": "Winback supervisor (per-member fan-out plan)",
            "position": {
              "x": 240,
              "y": 0
            },
            "config": {
              "childWorkflowId": "{{params.childWorkflowId}}",
              "fromAddress": "{{params.fromAddress}}",
              "orgId": "{{params.orgId}}",
              "subject": "{{params.subject}}",
              "body": "{{params.body}}"
            },
            "inputs": {}
          },
          {
            "id": "dispatch",
            "typeId": "core.dispatch",
            "name": "Fan out one re-engage child per member",
            "position": {
              "x": 480,
              "y": 0
            },
            "config": {
              "fanOutPolicy": "parallel",
              "joinPolicy": {
                "mode": "wait-all",
                "onChildFailure": "collect"
              }
            },
            "inputs": {}
          }
        ],
        "edges": [
          {
            "from": "segment.contactIds",
            "to": "plan.contactIds"
          },
          {
            "from": "plan",
            "to": "dispatch"
          }
        ]
      },
      "outputs": {
        "dispatched": {
          "type": "number",
          "description": "The number of per-member re-engage children fanned out (0 for an empty segment)."
        }
      }
    }
  ],
  "signing": {
    "method": "manual",
    "publicKeyRef": "openwop-team-1",
    "signatureRef": "keys/pack.json.sig"
  },
  "integrity": "sha256-K1m+XiUHLPFy+kaVtGmO7kbkWjKzRqxGGpLSLu24Xz8="
}
